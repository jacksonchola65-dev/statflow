# Application
APP_NAME="StatFlow API"
ENVIRONMENT=development

# Optional Sentry error tracking. Leave unset to disable external telemetry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# API
API_V1_PREFIX=/api/v1
REQUEST_ID_HEADER=X-Request-ID

# Trusted hostnames. Production/staging must list explicit deployment hosts.
TRUSTED_HOSTS=["localhost","127.0.0.1"]

# Database
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/statflow

# Database pool configuration (non-secret runtime tuning values)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:5173"]

# Test database (used only by pytest — never touches the development database)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/statflow_test

# ── JWT / Auth ─────────────────────────────────────────────────────────────────

# Secret key used to sign JWT access tokens.
# PRODUCTION: generate a strong random value with:
#   openssl rand -hex 32
# Never commit a real secret here — use a secrets manager or CI/CD env var.
JWT_SECRET_KEY=dev-only-secret-change-me-in-production

# Algorithm used to sign JWTs. HS256 (HMAC-SHA256) is the default symmetric choice.
JWT_ALGORITHM=HS256

# How long an access token remains valid, in minutes.
# 60 minutes is a sensible default for an internal app.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Cookie / CSRF (reserved for httpOnly-cookie auth) ─────────────────────────

# Set to true in production (required when behind HTTPS).
# COOKIE_SECURE must be true in any production deployment.
COOKIE_SECURE=false

# SameSite policy for auth cookies. Options: lax | strict | none
# "lax" is the recommended default (prevents CSRF on navigations, allows normal use).
COOKIE_SAMESITE=lax

# Name of the CSRF cookie that the server sets on the browser.
CSRF_COOKIE_NAME=statflow_csrf

# Name of the request header the client must echo back for CSRF verification.
CSRF_HEADER_NAME=X-CSRF-Token

# Name of the HttpOnly cookie that carries the JWT access token.
AUTH_COOKIE_NAME=statflow_access

# ── Admin seed ────────────────────────────────────────────────────────────────

# Email address used to create the initial admin account.
# Run:  python -m app.db.seeders.users
ADMIN_EMAIL=admin@statflow.test

# Plaintext password for the initial admin account (hashed before storage).
# PRODUCTION: set a strong, unique value here or via your secrets manager.
ADMIN_PASSWORD=ChangeMe123!

# ── Ingestion limits ──────────────────────────────────────────────────────────

# Maximum file size accepted by the ingestion endpoint, measured in bytes.
# The size is checked against the raw upload length before any parsing begins.
# Default: 10485760 (10 MB).
INGESTION_MAX_FILE_BYTES=10485760

# Maximum number of data rows allowed per uploaded file.
# The row limit is applied after the file is parsed and the header row is identified.
# Default: 100000.
INGESTION_MAX_ROWS=100000

# Maximum number of columns allowed per uploaded file.
# The column limit is applied immediately after the header row is parsed.
# Default: 500.
INGESTION_MAX_COLUMNS=500

# Production/staging contract:
# - inject DATABASE_URL, JWT_SECRET_KEY, and ADMIN_PASSWORD from the platform
#   environment or an external secret manager; never commit their values.
# - use separate database, JWT secret, admin credentials, cookie names, and
#   HTTPS origin for staging and production.
# - set ENVIRONMENT=staging or production, COOKIE_SECURE=true, explicit
#   TRUSTED_HOSTS, and a non-localhost CORS_ORIGINS value.
